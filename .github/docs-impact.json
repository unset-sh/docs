{
  "schemaVersion": 1,
  "exclude": [
    { "prefix": "tests/" },
    { "prefix": "vendor/" },
    { "prefix": "assets/js/vendor/" },
    { "prefix": "node_modules/" },
    { "prefix": ".build/" },
    { "prefix": "public/" },
    { "prefix": "resources/" },
    { "exact": "data/org-map/repos.json" },
    { "exact": "data/org-map/source.json" },
    { "exact": "data/workflow-map/catalogue.json" }
  ],
  "documentation": [
    { "exact": "README.md" },
    { "exact": ".github/CONTRIBUTING.md" },
    { "exact": ".github/DOCS-UPKEEP.md" },
    { "exact": ".github/THIRD-PARTY-NOTICES.md" },
    { "prefix": "content/" }
  ],
  "rules": [
    {
      "id": "workflow-map",
      "source": [
        { "exact": ".github/maps.json" },
        { "exact": "scripts/update-workflow-map.mjs" },
        { "exact": "scripts/workflow-view.mjs" },
        { "exact": "scripts/check-workflow-map.py" },
        { "exact": "data/workflow-map/collector.json" },
        { "exact": "layouts/_shortcodes/workflow-map.html" },
        { "exact": "layouts/_partials/workflow-entry.html" },
        { "exact": "layouts/_partials/workflow-permissions.html" },
        { "exact": "assets/css/workflow-map.css" }
      ],
      "docs": [{ "exact": "content/workflows.md" }]
    },
    {
      "id": "organisation-map",
      "source": [
        { "exact": "scripts/update-map.mjs" },
        { "exact": "scripts/map-layout.mjs" },
        { "exact": "layouts/_shortcodes/organisation-map.html" },
        { "exact": "layouts/_partials/org-map-graph.html" },
        { "exact": "assets/css/org-map.css" },
        { "exact": "assets/js/org-map.js" }
      ],
      "docs": [{ "exact": "content/organisation.md" }]
    },
    {
      "id": "documentation-maintenance",
      "source": [
        { "exact": "scripts/check-docs-impact.mjs" },
        { "exact": ".github/docs-impact.json" }
      ],
      "docs": [{ "exact": ".github/DOCS-UPKEEP.md" }, { "exact": ".github/CONTRIBUTING.md" }]
    },
    {
      "id": "build-and-dependencies",
      "source": [
        { "prefix": "scripts/" },
        { "exact": "package.json" },
        { "exact": "package-lock.json" },
        { "exact": ".npmrc" },
        { "exact": ".nvmrc" },
        { "exact": "go.mod" },
        { "exact": "go.sum" }
      ],
      "docs": [{ "exact": "README.md" }, { "exact": ".github/CONTRIBUTING.md" }, { "exact": "content/updates.md" }]
    },
    {
      "id": "reading-and-rendering",
      "source": [{ "prefix": "layouts/" }, { "prefix": "assets/" }, { "exact": "hugo.yaml" }],
      "docs": [{ "exact": ".github/CONTRIBUTING.md" }, { "exact": "README.md" }, { "exact": "content/updates.md" }]
    },
    {
      "id": "publication",
      "source": [{ "prefix": ".github/workflows/" }],
      "docs": [{ "exact": "README.md" }, { "exact": ".github/CONTRIBUTING.md" }, { "exact": "content/updates.md" }]
    }
  ],
  "fallback": {
    "id": "other-source",
    "docs": [{ "exact": "README.md" }, { "exact": ".github/CONTRIBUTING.md" }, { "prefix": "content/" }]
  }
}
